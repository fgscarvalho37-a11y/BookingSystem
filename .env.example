# Database server-side only. Run sql/schema.sql in your staging PostgreSQL first.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# A long unpredictable value. NEVER use a short demo password in production.
ADMIN_PASSWORD=replace-with-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Private Orbitta backend endpoint (NOT a public browser URL)
ORBITTA_LICENSE_URL=https://your-orbitta-backend.example.com/api/internal/bookings/licenses
# Same value as orbitta.bookings.license-key in Orbitta backend; configure server side.
ORBITTA_LICENSE_TOKEN=replace-with-shared-random-secret

# Orbitta catalog product slug, set on the Orbitta backend service to match your product
# ORBITTA_BOOKINGS_PRODUCT_SLUG=orbitta-bookings
